# sentaurus-bridge-lite local configuration
#
# Copy this file to .env and edit it. Keep .env private; do not commit it.
#
# Minimal setup:
#   SB_REMOTE_HOST=192.168.56.101
#   SB_REMOTE_USER=eda
#   SB_SENTAURUS_SETUP=source /opt/synopsys/sentaurus/V-2023.09/settings.sh

# SSH target. SB_REMOTE_HOST can also be an alias from ~/.ssh/config.
SB_REMOTE_HOST=
SB_REMOTE_USER=
SB_REMOTE_PORT=22

# Optional SSH settings.
# SB_SSH_KEY=C:/Users/you/.ssh/id_ed25519
# SB_SSH_CONFIG=C:/Users/you/.ssh/config
# SB_JUMP_HOST=
# SB_JUMP_USER=
# SB_SSH_EXTRA_ARGS=-o ServerAliveInterval=30

# Host alias used by `sentaurus-bridge ssh-config` and `sentaurus-bridge code`.
SB_SSH_ALIAS=sentaurus-vm

# Remote directory used by run/push/pull when no directory is specified.
SB_REMOTE_WORKDIR=~/sentaurus-work

# Sentaurus environment setup. Prefer a shell snippet that works in a fresh SSH
# login shell. Examples:
#   SB_SENTAURUS_SETUP=source /opt/synopsys/sentaurus/V-2023.09/settings.sh
#   SB_SENTAURUS_SETUP=module load sentaurus
#   SB_SENTAURUS_SETUP=export STROOT=/opt/synopsys/sentaurus/V-2023.09; export PATH=$STROOT/bin:$PATH
SB_SENTAURUS_SETUP=

# Alternative convenience if your setup is a bash-compatible file.
# SB_SENTAURUS_INIT=/opt/synopsys/sentaurus/V-2023.09/settings.sh
# SB_SENTAURUS_ROOT=/opt/synopsys/sentaurus/V-2023.09

# Remote shell used for setup/run commands. bash is recommended.
SB_REMOTE_SHELL=bash

# Tools checked by `sentaurus-bridge doctor`.
SB_SENTAURUS_TOOLS=sentaurus,sdevice,sde,svisual,swb

# GUI forwarding. On Windows, start VcXsrv/Xming first if you use X11.
SB_ENABLE_X11=0
# SB_DISPLAY=localhost:0.0

# Optional local tool overrides.
# SB_SSH_CMD=C:/Windows/System32/OpenSSH/ssh.exe
# SB_SCP_CMD=C:/Windows/System32/OpenSSH/scp.exe
