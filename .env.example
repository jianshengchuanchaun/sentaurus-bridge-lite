# sentaurus-bridge-lite configuration (keep the real .env private)
# Process environment variables override values in this file.

# SSH hostname, IP address, or existing ~/.ssh/config alias.
SB_REMOTE_HOST=
SB_REMOTE_USER=
SB_REMOTE_PORT=22
# SB_SSH_KEY=C:/Users/you/.ssh/id_ed25519
# SB_SSH_CONFIG=C:/Users/you/.ssh/config
# SB_JUMP_HOST=bastion.example.org
# SB_JUMP_USER=you
# SB_SSH_EXTRA_ARGS=-o ServerAliveInterval=30
SB_SSH_ALIAS=sentaurus-vm

# Managed jobs and MCP file operations stay under this directory.
# Prefer the desktop user's project directory if using `desktop open`.
SB_REMOTE_WORKDIR=~/sentaurus-work

# Load the actual site environment and license configuration.
# SB_SENTAURUS_ROOT=/opt/synopsys/sentaurus/your-version
# SB_SENTAURUS_INIT=/path/to/site-setup.sh
# Example: source /path/to/site-setup.sh
# Example: export SNPSLMD_LICENSE_FILE=27000@your-license-server
SB_SENTAURUS_SETUP=
SB_REMOTE_SHELL=bash
# 1 preserves the original login-shell behavior; 0 avoids broken site profiles.
SB_LOGIN_SHELL=1

# Names allowed by submit_tool and checked by doctor.
# This is not a sandbox: scripts run with the SSH account's permissions.
SB_SENTAURUS_TOOLS=sdevice,sde,svisual,swb

# Managed jobs / MCP / desktop helpers need remote Linux + Python 3.6+.
SB_REMOTE_PYTHON=python3
# Select the VM graphical user when multiple X11 sessions exist.
# SB_DESKTOP_USER=tcad

# Optional X11 forwarding to a local X server. Not needed by desktop open.
SB_ENABLE_X11=0
# SB_DISPLAY=localhost:0.0

# Optional local executable paths.
# SB_SSH_CMD=C:/Windows/System32/OpenSSH/ssh.exe
# SB_SCP_CMD=C:/Windows/System32/OpenSSH/scp.exe
